# Required at runtime for contact + free-inspection emails (Resend).
# Not required for `npm run build`.
RESEND_API_KEY=

# Inbox that receives form submissions. Falls back to a hardcoded address if unset.
CONTACT_EMAIL=

# Required at runtime to sign in at /admin/leads.
ADMIN_PASSWORD=

# Local only — used by `npm run generate-images`. Not needed on Vercel.
# XAI_API_KEY=
